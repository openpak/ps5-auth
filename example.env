# HTTP listen address. TLS is terminated by the reverse proxy in front (Traefik) for
# ca.account.sony.com, auth.api.sonyentertainmentnetwork.com and np.ac.playstation.net.
PS5_ADDR=:8080
# Required: HMAC key for tokens, at least 32 bytes.
PS5_TOKEN_KEY=
# OpenPak account core. REQUIRED (both) unless PS5_DEV_MEMORY=1.
# PS5_ACCOUNT_CORE_URL=http://openpak-account:7000
# PS5_ACCOUNT_CORE_TOKEN=
# Local development only: in-memory accounts, lost on restart. Without the core and this flag the service refuses to start.
# PS5_DEV_MEMORY=1
# Development only, with PS5_DEV_MEMORY=1: email:password:accountId
# PS5_DEV_ACCOUNT=
# PS5_LOG_LEVEL=info
